+#!/usr/bin/env bash
+set -euo pipefail
+
+# Run a PromptHMR command against the audited, repository-local caches.  The
+# offline flags are intentional: a frozen experiment must fail closed instead
+# of silently fetching a newer asset or writing to a user's default cache.
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+export TORCH_HOME="${repo_root}/data/cache/torch"
+export HF_HOME="${repo_root}/data/cache/huggingface"
+export HF_HUB_CACHE="${HF_HOME}/hub"
+export HF_HUB_OFFLINE=1
+export TRANSFORMERS_OFFLINE=1
+export HF_HUB_DISABLE_TELEMETRY=1
+
+exec "$@"
