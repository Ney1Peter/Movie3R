+#!/usr/bin/env python3
+"""Derive PromptHMR's SMPL-joint regressor on the SMPL-X vertex domain.
+
+This script does not download or redistribute body-model data.  It derives a
+small helper from SMPL/SMPL-X assets already present in the local PromptHMR
+checkout and records enough information to reproduce and audit the result.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import pickle
+from datetime import datetime, timezone
+from pathlib import Path
+
+import numpy as np
+from scipy import sparse
+import torch
+
+
+EXPECTED_SMPL_NATIVE_JOINTS = 24
+EXPECTED_SMPL_EXTRA_JOINTS = 9
+EXPECTED_PROMPTHMR_JOINTS = EXPECTED_SMPL_NATIVE_JOINTS + EXPECTED_SMPL_EXTRA_JOINTS
+EXPECTED_SMPL_VERTICES = 6890
+EXPECTED_SMPLX_VERTICES = 10475
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def load_inputs(
+    smpl_path: Path,
+    extra_regressor_path: Path,
+    conversion_path: Path,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    with smpl_path.open("rb") as stream:
+        smpl_data = pickle.load(stream, encoding="latin1")
+    with conversion_path.open("rb") as stream:
+        conversion_data = pickle.load(stream, encoding="latin1")
+
+    smpl_j_regressor = smpl_data["J_regressor"]
+    if sparse.issparse(smpl_j_regressor):
+        smpl_j_regressor = smpl_j_regressor.toarray()
+    smpl_j_regressor = np.asarray(smpl_j_regressor, dtype=np.float64)
+    extra_j_regressor = np.asarray(
+        np.load(extra_regressor_path, allow_pickle=False), dtype=np.float64
+    )
+    smplx2smpl = np.asarray(conversion_data["matrix"], dtype=np.float64)
+
+    expected_j_shape = (EXPECTED_SMPL_NATIVE_JOINTS, EXPECTED_SMPL_VERTICES)
+    expected_extra_shape = (EXPECTED_SMPL_EXTRA_JOINTS, EXPECTED_SMPL_VERTICES)
+    expected_conversion_shape = (EXPECTED_SMPL_VERTICES, EXPECTED_SMPLX_VERTICES)
+    if smpl_j_regressor.shape != expected_j_shape:
+        raise ValueError(
+            f"Unexpected neutral-SMPL J_regressor shape: "
+            f"{smpl_j_regressor.shape}, expected {expected_j_shape}"
+        )
+    if extra_j_regressor.shape != expected_extra_shape:
+        raise ValueError(
+            f"Unexpected extra-joint regressor shape: "
+            f"{extra_j_regressor.shape}, expected {expected_extra_shape}"
+        )
+    if smplx2smpl.shape != expected_conversion_shape:
+        raise ValueError(
+            f"Unexpected SMPL-X-to-SMPL matrix shape: "
+            f"{smplx2smpl.shape}, expected {expected_conversion_shape}"
+        )
+    if (
+        not np.isfinite(smpl_j_regressor).all()
+        or not np.isfinite(extra_j_regressor).all()
+        or not np.isfinite(smplx2smpl).all()
+    ):
+        raise ValueError("Input regressors contain non-finite values")
+    return smpl_j_regressor, extra_j_regressor, smplx2smpl
+
+
+def validate(
+    combined_j_regressor: np.ndarray,
+    smplx2smpl: np.ndarray,
+    smplx_joint_regressor: np.ndarray,
+) -> dict[str, float | int | list[int]]:
+    expected_shape = (EXPECTED_PROMPTHMR_JOINTS, EXPECTED_SMPLX_VERTICES)
+    if smplx_joint_regressor.shape != expected_shape:
+        raise ValueError(
+            f"Unexpected derived regressor shape: "
+            f"{smplx_joint_regressor.shape}, expected {expected_shape}"
+        )
+    if not np.isfinite(smplx_joint_regressor).all():
+        raise ValueError("Derived regressor contains non-finite values")
+
+    rng = np.random.default_rng(20260821)
+    vertices64 = rng.standard_normal((4, EXPECTED_SMPLX_VERTICES, 3))
+    direct64 = np.einsum("jk,bkc->bjc", smplx_joint_regressor, vertices64)
+    composed64 = np.einsum(
+        "ji,bic->bjc",
+        combined_j_regressor,
+        np.einsum("ik,bkc->bic", smplx2smpl, vertices64),
+    )
+    error64 = direct64 - composed64
+
+    # PromptHMR calls torch.from_numpy(...).float(), so explicitly audit the
+    # numerical error after the same float32 conversion used at runtime.
+    j32 = combined_j_regressor.astype(np.float32)
+    conversion32 = smplx2smpl.astype(np.float32)
+    derived32 = smplx_joint_regressor.astype(np.float32)
+    vertices32 = vertices64.astype(np.float32)
+    direct32 = np.einsum("jk,bkc->bjc", derived32, vertices32)
+    composed32 = np.einsum(
+        "ji,bic->bjc",
+        j32,
+        np.einsum("ik,bkc->bic", conversion32, vertices32),
+    )
+    error32 = direct32 - composed32
+
+    stats: dict[str, float | int | list[int]] = {
+        "derived_shape": list(smplx_joint_regressor.shape),
+        "derived_nonzero_count": int(np.count_nonzero(smplx_joint_regressor)),
+        "smpl_native_j_row_sum_max_abs_error_from_one": float(
+            np.max(
+                np.abs(
+                    combined_j_regressor[:EXPECTED_SMPL_NATIVE_JOINTS].sum(axis=1)
+                    - 1.0
+                )
+            )
+        ),
+        "smpl_extra_j_row_sum_max_abs_error_from_one": float(
+            np.max(
+                np.abs(
+                    combined_j_regressor[EXPECTED_SMPL_NATIVE_JOINTS:].sum(axis=1)
+                    - 1.0
+                )
+            )
+        ),
+        "smplx2smpl_row_sum_max_abs_error_from_one": float(
+            np.max(np.abs(smplx2smpl.sum(axis=1) - 1.0))
+        ),
+        "derived_native_row_sum_max_abs_error_from_one": float(
+            np.max(
+                np.abs(
+                    smplx_joint_regressor[:EXPECTED_SMPL_NATIVE_JOINTS].sum(axis=1)
+                    - 1.0
+                )
+            )
+        ),
+        "derived_extra_row_sum_max_abs_error_from_one": float(
+            np.max(
+                np.abs(
+                    smplx_joint_regressor[EXPECTED_SMPL_NATIVE_JOINTS:].sum(axis=1)
+                    - 1.0
+                )
+            )
+        ),
+        "associativity_float64_max_abs_error": float(np.max(np.abs(error64))),
+        "associativity_float64_rms_error": float(np.sqrt(np.mean(error64**2))),
+        "associativity_float32_max_abs_error": float(np.max(np.abs(error32))),
+        "associativity_float32_rms_error": float(np.sqrt(np.mean(error32**2))),
+    }
+
+    if stats["derived_native_row_sum_max_abs_error_from_one"] > 1e-12:
+        raise ValueError(f"Native SMPL rows are not translation equivariant: {stats}")
+    # The public nine-joint regressor itself has row-sum residuals up to
+    # 1.3836e-4. Preserve that source exactly instead of silently renormalizing
+    # it; the official PromptHMR checkpoint contains the same residuals.
+    if stats["derived_extra_row_sum_max_abs_error_from_one"] > 2e-4:
+        raise ValueError(f"Extra-joint row sums exceed the source tolerance: {stats}")
+    if stats["associativity_float64_max_abs_error"] > 1e-12:
+        raise ValueError(f"Float64 composition check failed: {stats}")
+    if stats["associativity_float32_max_abs_error"] > 2e-6:
+        raise ValueError(f"Float32 PromptHMR-runtime composition check failed: {stats}")
+    return stats
+
+
+def validate_checkpoint(
+    checkpoint_path: Path,
+    smplx_joint_regressor: np.ndarray,
+) -> dict[str, float | int | list[int] | str | bool]:
+    checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=True)
+    checkpoint_regressor = (
+        checkpoint["state_dict"]["smplx.smpl_joints"].detach().cpu().numpy()
+    )
+    runtime_regressor = smplx_joint_regressor.astype(np.float32)
+    if checkpoint_regressor.shape != runtime_regressor.shape:
+        raise ValueError(
+            f"Checkpoint expects {checkpoint_regressor.shape}, but the derived "
+            f"PromptHMR runtime buffer has {runtime_regressor.shape}"
+        )
+    max_abs_error = float(np.max(np.abs(checkpoint_regressor - runtime_regressor)))
+    mismatch_count = int(np.count_nonzero(checkpoint_regressor != runtime_regressor))
+    if max_abs_error > 5e-7:
+        raise ValueError(
+            f"Derived regressor does not reproduce the checkpoint buffer: "
+            f"max_abs_error={max_abs_error}"
+        )
+    return {
+        "checkpoint_path": str(checkpoint_path),
+        "checkpoint_sha256": sha256(checkpoint_path),
+        "checkpoint_buffer_shape": list(checkpoint_regressor.shape),
+        "derived_float32_shape": list(runtime_regressor.shape),
+        "max_abs_error": max_abs_error,
+        "bitwise_mismatch_count": mismatch_count,
+        "strict_load_shape_compatible": True,
+    }
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--smpl",
+        type=Path,
+        default=Path("data/body_models/smpl/SMPL_NEUTRAL.pkl"),
+    )
+    parser.add_argument(
+        "--extra-j-regressor",
+        type=Path,
+        default=Path("../ROMP/assets/smpl_model_data/J_regressor_extra.npy"),
+        help=(
+            "Public SPIN/ROMP-style regressor for the nine extra SMPL joints "
+            "retained by the PromptHMR checkpoint"
+        ),
+    )
+    parser.add_argument(
+        "--smplx2smpl",
+        type=Path,
+        default=Path("data/body_models/smplx2smpl.pkl"),
+    )
+    parser.add_argument(
+        "--checkpoint",
+        type=Path,
+        default=Path("data/pretrain/phmr/checkpoint.ckpt"),
+        help="Official PromptHMR image checkpoint used only for shape/value audit",
+    )
+    parser.add_argument(
+        "--output",
+        type=Path,
+        default=Path("data/body_models/smplx2smpl_joints.npy"),
+    )
+    parser.add_argument(
+        "--provenance",
+        type=Path,
+        default=Path("data/body_models/smplx2smpl_joints.provenance.json"),
+    )
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    for input_path in (
+        args.smpl,
+        args.extra_j_regressor,
+        args.smplx2smpl,
+        args.checkpoint,
+    ):
+        if not input_path.is_file():
+            raise FileNotFoundError(input_path)
+
+    smpl_j_regressor, extra_j_regressor, smplx2smpl = load_inputs(
+        args.smpl, args.extra_j_regressor, args.smplx2smpl
+    )
+    combined_j_regressor = np.concatenate(
+        [smpl_j_regressor, extra_j_regressor], axis=0
+    )
+    # For any SMPL-X vertices Vx, first converting to SMPL vertices and then
+    # regressing joints gives J_combined @ (M_x2s @ Vx). Associativity gives
+    # the 33-row PromptHMR regressor (J_combined @ M_x2s) on Vx directly.
+    smplx_joint_regressor = combined_j_regressor @ smplx2smpl
+    validation = validate(combined_j_regressor, smplx2smpl, smplx_joint_regressor)
+    checkpoint_validation = validate_checkpoint(args.checkpoint, smplx_joint_regressor)
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    np.save(args.output, smplx_joint_regressor, allow_pickle=False)
+    roundtrip = np.load(args.output, allow_pickle=False)
+    if not np.array_equal(roundtrip, smplx_joint_regressor):
+        raise RuntimeError("Saved regressor failed byte-independent NumPy round trip")
+
+    provenance = {
+        "schema_version": 1,
+        "created_utc": datetime.now(timezone.utc).isoformat(),
+        "formula": (
+            "concatenate(SMPL_NEUTRAL.J_regressor, J_regressor_extra_9) "
+            "@ smplx2smpl['matrix']"
+        ),
+        "purpose": (
+            "24 native SMPL plus 9 public extra joints regressed directly from "
+            "the 10475 SMPL-X vertices; consumed by "
+            "prompt_hmr/smpl_family/smpl_wrapper.py"
+        ),
+        "storage_dtype": str(smplx_joint_regressor.dtype),
+        "runtime_dtype": (
+            "float32 (PromptHMR loads the NumPy array with torch.from_numpy(...).float())"
+        ),
+        "inputs": {
+            "smpl_neutral": {
+                "path": str(args.smpl),
+                "resolved_path": str(args.smpl.resolve()),
+                "sha256": sha256(args.smpl),
+            },
+            "extra_j_regressor": {
+                "path": str(args.extra_j_regressor),
+                "resolved_path": str(args.extra_j_regressor.resolve()),
+                "sha256": sha256(args.extra_j_regressor),
+                "source_note": (
+                    "Public nine-joint SMPL helper in the locally cloned ROMP "
+                    "baseline; identical SHA256 to the locally cloned TRAM copy"
+                ),
+            },
+            "smplx2smpl": {
+                "path": str(args.smplx2smpl),
+                "resolved_path": str(args.smplx2smpl.resolve()),
+                "sha256": sha256(args.smplx2smpl),
+            },
+        },
+        "validation": validation,
+        "checkpoint_validation": checkpoint_validation,
+        "output": {
+            "path": str(args.output),
+            "bytes": args.output.stat().st_size,
+            "sha256": sha256(args.output),
+        },
+    }
+    args.provenance.write_text(
+        json.dumps(provenance, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    print(json.dumps(provenance, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
