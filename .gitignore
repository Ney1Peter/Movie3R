# Large, regenerable tensors and scheduler locks from the publication multi-cut
# replay.  Keep the small manifests, runtime JSON, metrics, figures and logs
# versioned as audit evidence; never store model-sized per-case arrays here.
publication/bridge3r_iclr2027/multicut/runs/*.npz
publication/bridge3r_iclr2027/multicut/runs/.gpu_locks/
src/croco/models/curope/cuda_12.4.0_550.54.14_linux.run

